from __future__ import annotations

import json
import logging
import math
from collections import Counter
from dataclasses import dataclass
from typing import Optional

from django.conf import settings

logger = logging.getLogger(__name__)


@dataclass
class MatchResult:
    service: object
    score: float
    reason: str


@dataclass
class Recommendation:
    service: object
    score: float
    confidence: float
    language: str
    intent: str
    reply: str


def _client():
    from openai import OpenAI
    key = getattr(settings, "OPENAI_API_KEY", "")
    if not key:
        raise RuntimeError("OPENAI_API_KEY missing")
    return OpenAI(api_key=key)


def analyze_need(text: str) -> dict:
    try:
        resp = _client().chat.completions.create(
            model=getattr(settings, "OPENAI_MODEL", "gpt-4o-mini"),
            response_format={"type": "json_object"},
            messages=[
                {"role": "system",
                 "content": "Tu es un analyste commercial. Renvoie un JSON strict : "
                            '{"intent": string, "language": "fr"|"en", "confidence": float 0..1}.'},
                {"role": "user", "content": text},
            ],
        )
        return json.loads(resp.choices[0].message.content)
    except Exception as e:
        logger.warning("analyze_need failed: %s", e)
        return {"intent": "unknown", "language": "fr", "confidence": 0.5}


# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------

def _normalize_keywords(svc) -> list[str]:
    """Fusionne keywords_fr + keywords_en, découpe sur | et , puis déduplique."""
    raw = f"{svc.keywords_fr or ''},{svc.keywords_en or ''}"
    out, seen = [], set()
    for part in raw.replace("|", ",").split(","):
        k = part.strip().lower()
        if k and len(k) >= 3 and k not in seen:
            out.append(k)
            seen.add(k)
    return out


def _compute_idf(services) -> dict[str, float]:
    """
    IDF : un mot-clé qui apparaît dans beaucoup de prestations pèse moins.
    'clients' → poids faible | 'bot whatsapp' → poids fort.
    Retourne {keyword: poids 0.6..2.2}.
    """
    counter = Counter()
    for svc in services:
        for kw in set(_normalize_keywords(svc)):
            counter[kw] += 1
    n = len(services) or 1
    raw = {kw: math.log(n / (c + 1)) + 1 for kw, c in counter.items()}
    if not raw:
        return {}
    lo, hi = min(raw.values()), max(raw.values())
    span = (hi - lo) or 1
    return {kw: 0.6 + (v - lo) / span * 1.6 for kw, v in raw.items()}


def _score_service(text_lower: str, svc, idf_map: dict) -> tuple[float, list[str]]:
    """Retourne (score 0..1, keywords littéralement matchés)."""
    from rapidfuzz import fuzz

    title = (svc.title or "").lower()
    keywords = _normalize_keywords(svc)

    # --- Titre : max de 3 algos (robuste aux textes courts) ---
    title_score = max(
        fuzz.WRatio(text_lower, title),
        fuzz.token_set_ratio(text_lower, title),
        fuzz.partial_ratio(text_lower, title),
    )

    # --- Keywords : pondération IDF × longueur ---
    kw_items, matched = [], []
    for kw in keywords:
        if len(kw) < 3:
            continue
        if len(kw) >= 4 and kw in text_lower:
            s = 100
            matched.append(kw)
        else:
            s = max(
                fuzz.partial_ratio(text_lower, kw),
                fuzz.token_set_ratio(text_lower, kw),
            )
        # poids = IDF × nb_mots^0.6  (multi-mots = plus spécifique)
        weight = idf_map.get(kw, 1.0) * (len(kw.split()) ** 0.6)
        kw_items.append((s, weight))

    if kw_items:
        total_w = sum(w for _, w in kw_items)
        kw_score = sum(s * w for s, w in kw_items) / total_w if total_w else 0
    else:
        kw_score = 0

    # --- Combine : 40% titre + 60% keywords ---
    final = (0.40 * title_score + 0.60 * kw_score) / 100.0
    return final, matched


def match_services(text: str, top_k: int = 3) -> list[MatchResult]:
    from .models import Service

    if not text or not text.strip():
        return []

    services = list(Service.objects.filter(is_active=True))
    if not services:
        return []

    idf_map = _compute_idf(services)
    text_lower = text.lower()

    results = []
    for svc in services:
        score, matched = _score_service(text_lower, svc, idf_map)
        reason = "matched: " + ", ".join(matched[:3]) if matched else ""
        results.append(MatchResult(service=svc, score=score, reason=reason))

    results.sort(key=lambda m: m.score, reverse=True)
    return results[:top_k]


# ---------------------------------------------------------------------------
# Réponse
# ---------------------------------------------------------------------------

def generate_reply(text: str, service, language: str) -> str:
    try:
        resp = _client().chat.completions.create(
            model=getattr(settings, "OPENAI_MODEL", "gpt-4o-mini"),
            messages=[{
                "role": "user",
                "content": (
                    "Tu es un commercial chaleureux et utile. Le prospect a écrit :\n"
                    f'"""{text}"""\n'
                    f"Réponds en {language}, 3-4 phrases max, en proposant : {service.title}.\n"
                    f"Inclus l'URL {service.url_comeup}. Pas de pression, sois utile."
                ),
            }],
        )
        return resp.choices[0].message.content.strip()
    except Exception as e:
        logger.warning("generate_reply failed: %s", e)
        return (
            f"Bonjour, pour votre besoin je vous propose : {service.title}. "
            f"Plus d'infos : {service.url_comeup}"
        )


def recommend(
    text: str,
    *,
    min_score: Optional[float] = None,
    min_confidence: Optional[float] = None,
    top_k: int = 3,
) -> Optional[Recommendation]:
    min_score = min_score or getattr(settings, "SALESBOT_MIN_SCORE", 0.45)
    min_confidence = min_confidence or getattr(settings, "SALESBOT_MIN_CONFIDENCE", 0.50)

    if not text or len(text.strip()) < 15:
        return None

    analysis = analyze_need(text)
    if analysis.get("confidence", 0) < min_confidence:
        return None

    matches = match_services(text, top_k=top_k)
    if not matches or matches[0].score < min_score:
        return None

    best = matches[0]
    reply = generate_reply(text, best.service, analysis.get("language", "fr"))
    return Recommendation(
        service=best.service,
        score=best.score,
        confidence=analysis.get("confidence", 0),
        language=analysis.get("language", "fr"),
        intent=analysis.get("intent", "unknown"),
        reply=reply,
    )
